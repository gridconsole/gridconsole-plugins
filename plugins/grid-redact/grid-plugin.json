{
  "id": "grid-redact",
  "name": "grid-redact",
  "version": "0.1.0",
  "apiVersion": ">=0.1",
  "publisher": "grid console",
  "description": "Obfuscation applied to problem reports before you send one.",
  "permissions": {
    "network": [],
    "cardWrite": false,
    "filesystem": [],
    "shell": false
  },
  "hooks": [],
  "points": [
    "report.redactor"
  ],
  "activation": [],
  "configuration": {
    "rules": {"type": "path", "title": "Rules file", "default": "<config>/redact.toml"},
    "redactFileNames": {"type": "bool", "title": "Redact file names", "default": true},
    "keepStackTraces": {"type": "bool", "title": "Keep stack traces", "default": true}
  },
  "main": "index.js"
}

{
  "id": "codex-provider",
  "name": "codex-provider",
  "version": "0.1.0",
  "apiVersion": ">=0.1",
  "publisher": "grid console",
  "description": "Sessions through Codex CLI, and the stage prompts the default SDLC sends when it starts or resumes one.",
  "permissions": {
    "network": [],
    "cardWrite": false,
    "filesystem": [],
    "shell": false
  },
  "hooks": [],
  "points": [
    "agent.provider",
    "llm.provider"
  ],
  "activation": [],
  "configuration": {
    "prompts.prepare": {"type": "prompt", "title": "Prepare prompt", "default": "Settings › Commands"},
    "prompts.start": {"type": "prompt", "title": "Start prompt (no prepare stage)", "default": "Settings › Commands"},
    "prompts.build": {"type": "prompt", "title": "Build prompt", "default": "Settings › Commands"},
    "prompts.review": {"type": "prompt", "title": "Self-review prompt", "default": "Settings › Commands"},
    "prompts.deliver": {"type": "prompt", "title": "Deliver prompt", "default": "Settings › Commands"},
    "prompts.verify": {"type": "prompt", "title": "Verify prompt", "default": "Settings › Commands"},
    "defaultModel": {"type": "string", "title": "Default model", "default": ""},
    "sandbox": {"type": "enum", "title": "Sandbox", "default": "workspace-write", "options": ["read-only", "workspace-write", "danger-full-access"]},
    "mcpConfig": {"type": "file", "title": "MCP servers", "default": ".codex/config.toml"}
  },
  "main": "index.js"
}

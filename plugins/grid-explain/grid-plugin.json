{
  "id": "grid-explain",
  "name": "grid-explain",
  "version": "0.1.0",
  "apiVersion": ">=0.1",
  "publisher": "grid console",
  "description": "The code view’s file summaries and inline notes, and which model writes them.",
  "permissions": {
    "network": [],
    "cardWrite": false,
    "filesystem": [],
    "shell": false
  },
  "hooks": [],
  "points": [
    "file.explain",
    "editor.contextMenu",
    "keymap.command"
  ],
  "commands": [
    "grid-explain:describe-selection"
  ],
  "activation": [],
  "configuration": {
    "model": {
      "type": "enum",
      "title": "Summary model",
      "default": "haiku",
      "options": [
        "fable",
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    "inlineNotes": {
      "type": "bool",
      "title": "Inline notes",
      "default": true
    },
    "refreshOn": {
      "type": "enum",
      "title": "Refresh on",
      "default": "file change",
      "options": [
        "file change",
        "save",
        "manual"
      ]
    }
  },
  "main": "index.js"
}
